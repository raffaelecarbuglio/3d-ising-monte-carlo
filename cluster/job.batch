#!/bin/bash
#SBATCH --account=default
#SBATCH --partition=zefiro
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=1024
#SBATCH --time=23:59:00
#SBATCH --signal=USR1@120
#SBATCH --output=logs/slurm-%j.out
#SBATCH --error=logs/slurm-%j.err

set -euo pipefail
export LC_ALL=C

# Una sola esecuzione per campagna: i file delle catene non possono essere condivisi.
exec 9>.lock
flock -n 9 || { echo "Campaign already running." >&2; exit 1; }

pids=()
for input in inputs/new/*.in; do
    name=$(basename "$input" .in)
    if [[ -f "results/${name}_config.dat" ]]; then
        input="inputs/restart/${name}.in"
    fi
    srun --exclusive --nodes=1 --ntasks=1 --cpus-per-task=1 \
        ./ising "$input" > "logs/${name}-${SLURM_JOB_ID}.log" 2>&1 &
    pids+=("$!")
done

status=0
for pid in "${pids[@]}"; do
    wait "$pid" || status=1
done
exit "$status"
